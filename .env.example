# Gin API. Один и тот же порт для `go run` и Docker (хост и процесс внутри).
# После смены: docker compose up -d
PORT=18080
DATABASE_URL=postgres://cyber:cyber@localhost:55432/cyber_predict?sslmode=disable
CORS_ORIGIN=http://localhost:3000

# PandaScore (https://app.pandascore.co/signup). Empty = no live calendar (fixtures stay).
PANDASCORE_TOKEN=

# Hourly calendar refresh inside the API process. 0 or off = only manual POST /api/v1/jobs/sync-upcoming
SYNC_INTERVAL=1h
TOP_TEAMS=60
# true = both teams in top-60 set; if nobody matches, fallback to at least one
SYNC_REQUIRE_BOTH=false
# Optional. If set, sync endpoint requires header X-Sync-Key
SYNC_SECRET=

# Optional overrides
PANDASCORE_BASE_URL=https://api.pandascore.co
SAMPLE_MATCHES_PATH=data/sample_matches.csv
FIXTURES_PATH=data/fixtures/upcoming.json
MODEL_VERSION=0.1.0
